# Server
PORT=3000

# Shopify
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_KEY=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_WEBHOOK_SECRET=your_webhook_signing_secret

# WhatsApp notifications are sent via a Shopify Flow automation that uses the
# Whatflow app action. No Whatflow API keys are needed here — the backend fires
# a flowTriggerReceive mutation using the Shopify credentials above and Flow
# handles the rest. See SETUP.txt Step 2b for the Flow configuration.

# Email / SMTP
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use App Password for SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM=noreply@yourdomain.com

# Admin Dashboard
# Set a strong random string — passed as x-admin-key header to access /admin routes
ADMIN_API_KEY=your-secret-admin-key

# App base URL (used to build product URLs in notifications)
BASE_URL=https://your-app-url.com

# CORS — comma-separated list of allowed Shopify store origins
# Example: https://your-store.myshopify.com,https://www.yourcustomdomain.com
ALLOWED_ORIGINS=https://your-store.myshopify.com
